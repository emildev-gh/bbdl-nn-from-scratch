# Virtual environment created by uv
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Test, coverage, and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/

# Jupyter temporary files
.ipynb_checkpoints/

# Local environment and secrets
.env
.env.*
!.env.example

# Operating-system files
.DS_Store
Thumbs.db

# Local editor settings
.vscode/*
!.vscode/settings.json